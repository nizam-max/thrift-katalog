rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /products/{productId} {
      // Katalog publik hanya dapat dibaca.
      allow read: if true;

      // Hanya UID yang terdaftar di admins yang dapat mengelola produk.
      allow create, update, delete: if isAdmin();
    }

    // Admin boleh membaca dokumennya sendiri untuk verifikasi akses.
    // Dokumen admin tidak dapat dibuat/diubah/dihapus dari website.
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
